# AlephBits content-repo environment template.
#
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# The translation pipeline reads these variables from the environment.

# Required to run the DeepSeek translation provider. Must never be committed.
DEEPSEEK_API_KEY=

# Optional. Overrides the default model (deepseek-chat).
DEEPSEEK_MODEL=

# Optional. Overrides the default temperature (0.3).
DEEPSEEK_TEMPERATURE=

# Optional. Overrides the default request timeout in seconds (180).
DEEPSEEK_TIMEOUT_SECONDS=
